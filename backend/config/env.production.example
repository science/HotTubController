# Production Environment Configuration
# Copy this file to backend/.env on the production server
# Then replace the placeholders with your real API keys

APP_ENV=production

# External API Mode - Controls ALL external service calls
# live = real API calls (required for production)
EXTERNAL_API_MODE=live

# Hardware actuation — iot-api relay (REQUIRED in live mode)
# public/index.php wires IotApiClientFactory, so these two are mandatory:
# without them live mode throws "IOT_API_URL and IOT_API_JWT required".
#
# IOT_API_URL is a BASE url — IotApiClient appends /api/v1/device/{slug}.
# Do NOT point it at a full endpoint path.
IOT_API_URL=https://misuse.org/iot
# JWT minted with sub=hottub-webapp in the iot-api repo (bin/mint-jwt.php).
IOT_API_JWT=your-hottub-webapp-jwt-here

# IFTTT Configuration — LEGACY, retired in the 2026-07 cutover.
# Only needed if you roll public/index.php back to IftttClientFactory.
# Get your key from: https://ifttt.com/maker_webhooks/settings
IFTTT_WEBHOOK_KEY=your-production-key-here

# ESP32 Temperature Sensor Configuration
# API key for authenticating ESP32 temperature submissions
ESP32_API_KEY=your-esp32-api-key-here

# Authentication - Bootstrap Admin User
# CRITICAL: Change these credentials for production!
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-random-32-char-string
JWT_EXPIRY_HOURS=24

# API Base URL - Required for scheduled jobs and maintenance cron
# This is the full URL to the backend API (used by cron jobs)
API_BASE_URL=https://your-server.com/path/to/backend/public

# Cron JWT - Auto-generated by bin/generate-cron-jwt.php
# Run: php bin/generate-cron-jwt.php
# This creates a long-lived JWT for cron job authentication
# CRON_JWT=will-be-generated

# Optional Features
# Dining room blinds control (set to 'true' to enable)
BLINDS_FEATURE_ENABLED=true

# (iot-api relay settings now live near the top of this file, alongside the
# legacy IFTTT key they replaced. See
# ~/dev/home-assistant/docs/plans/ifttt-deprecation-iot-api.md for the cutover.)
